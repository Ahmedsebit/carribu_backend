{
  "name": "school-transport-backend",
  "version": "2.0.0",
  "scripts": {
    "prepare": "node scripts/setup-hooks.cjs",
    "precommit": "node scripts/precommit.cjs",
    "lint": "node scripts/lint.cjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:quality": "node --test scripts/precommit.test.cjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:seed": "node seeders/seed.js",
    "db:create-admin": "node seeders/create-super-admin.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:undo": "node scripts/migrate.js down",
    "db:migrate:pending": "node scripts/migrate.js pending",
    "db:migrate:status": "node scripts/migrate.js status",
    "test": "jest --runInBand",
    "test:auth": "jest tests/auth.test.js --runInBand",
    "test:resources": "jest tests/resources.test.js --runInBand",
    "test:trips": "jest tests/trips.test.js --runInBand",
    "test:messages": "jest tests/messages.test.js --runInBand",
    "test:e2e": "jest tests/e2e/ --runInBand",
    "test:workflow": "jest tests/e2e/workflow.test.js --runInBand",
    "test:socket": "jest tests/e2e/socket.test.js --runInBand --testPathIgnorePatterns /node_modules/",
    "test:location": "jest tests/e2e/locationTracking.test.js --runInBand --testPathIgnorePatterns /node_modules/"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.8",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "ws": "^8.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": [
      "prettier --write",
      "node scripts/lint.cjs"
    ],
    "*.{json,jsonc,css,scss,md,mdx,yaml,yml,html}": "prettier --write"
  }
}
