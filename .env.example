PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_transport
DB_USER=postgres
DB_PASSWORD=postgres
# Schema is managed by migrations (run automatically on startup).
# DB_SYNC is a DEPRECATED escape hatch: if set, startup uses sequelize.sync and
# SKIPS migrations. 'alter' adds/updates columns, 'safe' only creates missing
# tables, 'force' drops and recreates everything (data loss). Leave unset.
# DB_SYNC=alter
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Trip start reminders: how many minutes before a scheduled trip's start time
# the assigned driver is sent a push reminder.
TRIP_REMINDER_LEAD_MINUTES=15
# Trips may only be started this many minutes before or after their scheduled
# time. After the window closes, an unstarted trip is marked missed.
TRIP_START_WINDOW_MINUTES=20
# Scheduled trip times are wall-clock in the school's local time; the DB stores
# no timezone, so interpret them at this UTC offset in hours (default +3, EAT).
SCHOOL_UTC_OFFSET_HOURS=3

# Native Android push notifications. Store the complete Firebase service
# account JSON as a single environment-variable value. Leave unset to keep
# Expo notifications working without enabling FCM delivery.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Traccar-managed hosting: backend obtains a session cookie using the account
# token, loads devices/latest positions, then receives live WebSocket updates.
# TRACCAR_URL is the server address, not the Traccar website or login-page URL.
TRACCAR_ENABLED=false
TRACCAR_URL=https://your-server.traccar.org
TRACCAR_TOKEN=

# Optional legacy/self-hosted webhooks (not required for hosted integration).
# Shared secret required by POST /tracker/position and POST /tracker/event.
# Set the same value in Traccar's FORWARD_HEADER and EVENT_FORWARD_HEADER:
# Authorization: Bearer <this value>
TRACKER_WEBHOOK_TOKEN=replace-with-a-long-random-secret
