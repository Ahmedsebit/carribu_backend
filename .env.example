PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_transport
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SYNC: how the schema is synced on startup. 'alter' adds/updates columns without dropping data (default),
# 'safe' only creates missing tables, 'force' drops and recreates everything (data loss).
DB_SYNC=alter
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

